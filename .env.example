# Copy to .env and fill in. .env is gitignored.

# --- Database ----------------------------------------------------------------
POSTGRES_USER=tracker
POSTGRES_DB=tracker
# Required. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# Used by scripts/migrate.mjs and `npm run dev` when running outside compose.
# Inside compose the app builds this itself from the POSTGRES_* values above.
DATABASE_URL=postgres://tracker:CHANGEME@localhost:5432/tracker

# --- Identity (Cloudflare Access) --------------------------------------------
# Access authenticates at the edge and signs a JWT on every request it proxies.
# The app verifies that signature and reads the email from it, which is how it
# knows which of the authorized people is calling.
#
# Both are required in production. With either missing, every data route returns
# 503 -- misconfiguration must never read as "no identity required".
#
# Team domain: Zero Trust -> Settings -> Custom Pages, or just the
# <team>.cloudflareaccess.com hostname you log in at. No scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# AUD tag: Zero Trust -> Access -> Applications -> your app -> Overview ->
# "Application Audience (AUD) Tag". Ties a token to this one application, so a
# token minted for some other app in the same account will not open this one.
CF_ACCESS_AUD=

# Development only. There is no Access header on localhost, so this stands in
# for the verified identity and the app provisions an account for it on first
# request. /dev/switch-user?email=... overrides it per browser profile, which is
# how you get two accounts locally.
#
# Setting this on a real deployment does nothing: the branch in lib/auth.ts that
# reads it is compiled out of a production build.
DEV_USER_EMAIL=you@example.com

# --- Photo import ------------------------------------------------------------
# One of: google-vision | claude | gemini | tesseract
#
# tesseract runs in the browser and needs no credential — it's the only one that
# works offline, and the fallback when nothing else is set up. The rest need the
# matching key below. A missing credential degrades to manual entry rather than
# breaking anything, so leaving all of this blank is a valid configuration.
OCR_PROVIDER=google-vision

# google-vision: an API key, not a service account. Create one in the Google
# Cloud console and restrict it to the Cloud Vision API. Free tier covers about
# 1000 images/month, well above expected use.
GOOGLE_VISION_API_KEY=

# claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
